DJANGO_DEBUG=False
DJANGO_SECRET_KEY=            # python manage.py generate_keys
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
PLATFORM_NAME=PharmaCloud
PLATFORM_BASE_DOMAIN=localhost
PLATFORM_CONTACT_EMAIL=
FRONTEND_URL=http://localhost:5173
# Neon PostgreSQL: pooled URL for the app, direct URL for migrations
DATABASE_URL=
DIRECT_DATABASE_URL=
REDIS_URL=                    # required in production (Render Key Value)
# Encryption keys: python manage.py generate_keys  (losing BACKUP_ENCRYPTION_KEY makes every backup unreadable)
FIELD_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY=
# Brevo (BREVO_SENDER_EMAIL must be a verified sender in Brevo)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# Cloudinary (uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Cloudflare R2 (backups only)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
BACKUP_ALLOW_RESTORE=False
# Monime: used only by `manage.py configure_monime --pharmacy <slug>`
MONIME_API_KEY=
MONIME_SPACE_ID=
MONIME_WEBHOOK_SECRET=
